{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["prisma-local"],
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run db:info)",
      "Bash(npm run db:list)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run db:info)",
      "PowerShell(npm run db:list)",
      "PowerShell(git status)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "ask": [
      "Bash(npm run db -- restore:*)",
      "PowerShell(npm run db -- restore:*)",
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(~/AppData/Local/LIFEQUEST/**)",
      "Edit(~/AppData/Local/LIFEQUEST/**)",
      "Bash(*--env=production*)",
      "PowerShell(*--env=production*)",
      "Bash(npx prisma migrate reset*)",
      "PowerShell(npx prisma migrate reset*)",
      "Bash(npx prisma db push*)",
      "PowerShell(npx prisma db push*)"
    ]
  }
}
