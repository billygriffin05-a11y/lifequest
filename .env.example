# LIFEQUEST environment template.
# Copy to `.env.local` (git-ignored) and fill in values. NEVER commit real values.
# Next.js loads .env.local automatically. CLI scripts read real environment variables.

# ── Local data ────────────────────────────────────────────────────────────────
# Which data set to use: production (your real data) | development | test.
# Defaults: `next start` → production, `next dev` → development, CLI → development.
# LIFEQUEST_ENV=development

# Override the data directory (default %LOCALAPPDATA%\LIFEQUEST[-env]).
# Must be OUTSIDE this project folder and preferably NOT inside OneDrive/Dropbox.
# LIFEQUEST_DATA_DIR=

# Automatic backups
LIFEQUEST_BACKUP_INTERVAL_HOURS=24
LIFEQUEST_BACKUP_RETAIN=14

# ── iPhone access over Tailscale ─────────────────────────────────────────────
# Comma-separated extra hostnames the server will answer to, e.g. your PC's
# Tailscale MagicDNS name. localhost / 127.0.0.1 are always allowed.
# LIFEQUEST_ALLOWED_HOSTS=my-pc.tail1234.ts.net

# ── Future integrations (NOT used yet — see INTEGRATIONS.md) ──────────────────
# Encryption key for OAuth tokens at rest (32 bytes, base64). Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Prefer storing it in Windows Credential Manager (planned) rather than here.
# LIFEQUEST_TOKEN_ENCRYPTION_KEY=

# Google Calendar (Google Cloud Console → OAuth client, "Web application").
# Step-by-step guide: open /settings in LIFEQUEST. Register exactly this redirect URI:
#   http://localhost:3000/api/integrations/google/callback
# Tokens are stored encrypted; the key lives in %LOCALAPPDATA%\LIFEQUEST\secrets (never here).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# TrueLayer Open Banking — SANDBOX ONLY until explicitly approved
# TRUELAYER_ENV=sandbox
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_REDIRECT_URI=http://localhost:3000/api/integrations/truelayer/callback

# Web Push (VAPID) — generate locally, public key may be exposed to the browser
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Supabase — OPTIONAL encrypted sync relay only; disabled by default and requires explicit approval.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
