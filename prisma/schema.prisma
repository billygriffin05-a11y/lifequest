// LIFEQUEST local database schema (SQLite, owned by the user's PC).
//
// Environment-setup phase: only infrastructure tables live here. Feature
// tables (quests, finance, fitness, ...) are added in later phases, each via
// its own migration. See ARCHITECTURE.md and .claude/skills/local-database.
//
// Conventions:
//  - Every syncable table gets: id (cuid), createdAt, updatedAt, deletedAt
//    (soft delete), version (Int, optimistic concurrency) and updatedByDevice.
//  - Money is stored as integer minor units (pence) — never Float.
//  - Never store bank passwords. OAuth tokens are stored encrypted (see SECURITY.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Key/value application settings. `value` is a JSON string.
model AppSetting {
  key             String   @id
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)
  updatedByDevice String   @default("pc")
}

/// Append-only audit trail for important actions (financial, rewards,
/// backups, restores, sync). Never store secrets or raw personal data in
/// `details` — store identifiers and summaries only.
model AuditEvent {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  actor      String
  action     String
  entityType String?
  entityId   String?
  /// Idempotency key: a repeated operation with the same key is rejected.
  idempotencyKey String? @unique
  details    String?

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// ── Google Calendar integration ──────────────────────────────────────────────

/// The single linked Google account. Tokens are AES-256-GCM encrypted with a
/// key stored OUTSIDE the database (data dir /secrets). Never log them.
model GoogleConnection {
  id                    String   @id @default("google")
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  /// The dedicated "LIFEQUEST" calendar this app created (app-created scope).
  calendarId            String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Pending calendar writes. Logged deeds are queued here and pushed to Google
/// in the background, so logging never waits on (or fails because of) Google.
model CalendarOutbox {
  id          String    @id @default(cuid())
  /// "create" | "delete"
  op          String
  /// Deterministic Google event id (idempotent create/delete).
  eventId     String
  /// JSON event body for creates (summary, start, end, …).
  payload     String?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([doneAt])
}

// ── Dragons ──────────────────────────────────────────────────────────────────

/// Owner customisations for an area dragon (growth itself is derived from XP).
model DragonProfile {
  /// Area id, e.g. "fitness".
  areaId     String   @id
  customName String?
  /// Equipped cosmetic item id from the treasure shop (see src/features/treasury/catalog.ts).
  accessory  String?
  updatedAt  DateTime @updatedAt
}

/// Gold spent in the treasure shop. Append-only; the gold balance is derived
/// (earned from deeds/bonuses minus purchases). One purchase per item.
model Purchase {
  id          String   @id @default(cuid())
  itemId      String   @unique
  price       Int
  purchasedAt DateTime @default(now())
}

// ── Honour: customisable good / bad actions ─────────────────────────────────

/// A user-defined good or bad action, e.g. "Gym session" (+20, good) or
/// "Takeaway" (15, bad). Definitions persist day to day; archiving hides an
/// action from logging without losing its history.
model PointAction {
  id              String       @id @default(cuid())
  name            String
  /// "good" | "bad" (validated in src/features/honour/schemas.ts)
  kind            String
  /// Positive magnitude. Good adds Honour (and XP); bad subtracts Honour.
  points          Int
  icon            String
  category        String
  sortOrder       Int          @default(0)
  /// Optional goal: times per week (Mon–Sun, Europe/London). Good actions only.
  weeklyTarget    Int?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  version         Int          @default(1)
  updatedByDevice String       @default("pc")
  entries         PointEntry[]

  @@index([kind, archivedAt])
}

/// Append-only Honour/XP ledger. Never updated or deleted: an undo is a new
/// entry that reverses the original (`reversesEntryId`). Totals are derived.
model PointEntry {
  id              String      @id @default(cuid())
  actionId        String
  action          PointAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  /// Snapshots so history stays correct if the action is later edited.
  kind            String
  actionName      String
  actionIcon      String
  /// Category at the time of logging — decides which area dragon gets the XP.
  actionCategory  String      @default("Other")
  /// Optional short note from the owner ("5k in 28 min"). Not part of scoring.
  note            String?
  /// Signed change to the Honour score.
  honourDelta     Int
  /// Change to XP (good actions only; negative only when reversing a good entry).
  xpDelta         Int
  /// Local calendar day (Europe/London), YYYY-MM-DD.
  occurredOn      String
  occurredAt      DateTime    @default(now())
  /// Client-generated key: a retried request never creates a second entry.
  idempotencyKey  String      @unique
  /// Set on reversal entries; unique so an entry can only be undone once.
  reversesEntryId String?     @unique
  createdAt       DateTime    @default(now())
  updatedByDevice String      @default("pc")

  @@index([occurredOn])
  @@index([actionId])
  @@index([actionCategory])
}

// ── Money (all amounts in integer pence, GBP) ───────────────────────────────

/// A spending category with an optional monthly limit.
model BudgetCategory {
  id                String        @id @default(cuid())
  name              String        @unique
  icon              String
  /// Monthly budget in pence; 0 = track only, no limit.
  monthlyLimitPence Int           @default(0)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  version           Int           @default(1)
  transactions      Transaction[]
}

/// One money movement. amountPence > 0 = spending, < 0 = income/refund.
/// Soft-deleted (deletedAt) so history and audit stay intact.
model Transaction {
  id          String          @id @default(cuid())
  occurredOn  String
  amountPence Int
  description String
  categoryId  String?
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// "manual" | "import"
  source      String          @default("manual")
  /// Import de-duplication fingerprint (null for manual entries).
  importHash  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([occurredOn])
  @@index([categoryId])
}

model SavingsGoal {
  id          String           @id @default(cuid())
  name        String
  icon        String
  targetPence Int
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  deposits    SavingsDeposit[]
}

/// Append-only: withdrawals are negative deposits.
model SavingsDeposit {
  id          String      @id @default(cuid())
  goalId      String
  goal        SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  amountPence Int
  occurredOn  String
  createdAt   DateTime    @default(now())

  @@index([goalId])
}
