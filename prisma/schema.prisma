// LIFEQUEST local database schema (SQLite, owned by the user's PC).
//
// Environment-setup phase: only infrastructure tables live here. Feature
// tables (quests, finance, fitness, ...) are added in later phases, each via
// its own migration. See ARCHITECTURE.md and .claude/skills/local-database.
//
// Conventions:
//  - Every syncable table gets: id (cuid), createdAt, updatedAt, deletedAt
//    (soft delete), version (Int, optimistic concurrency) and updatedByDevice.
//  - Money is stored as integer minor units (pence) — never Float.
//  - Never store bank passwords. OAuth tokens are stored encrypted (see SECURITY.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Key/value application settings. `value` is a JSON string.
model AppSetting {
  key             String   @id
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)
  updatedByDevice String   @default("pc")
}

/// Append-only audit trail for important actions (financial, rewards,
/// backups, restores, sync). Never store secrets or raw personal data in
/// `details` — store identifiers and summaries only.
model AuditEvent {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  actor      String
  action     String
  entityType String?
  entityId   String?
  /// Idempotency key: a repeated operation with the same key is rejected.
  idempotencyKey String? @unique
  details    String?

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// ── Google Calendar integration ──────────────────────────────────────────────

/// The single linked Google account. Tokens are AES-256-GCM encrypted with a
/// key stored OUTSIDE the database (data dir /secrets). Never log them.
model GoogleConnection {
  id                    String   @id @default("google")
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  /// The dedicated "LIFEQUEST" calendar this app created (app-created scope).
  calendarId            String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Pending calendar writes. Logged deeds are queued here and pushed to Google
/// in the background, so logging never waits on (or fails because of) Google.
model CalendarOutbox {
  id          String    @id @default(cuid())
  /// "create" | "delete"
  op          String
  /// Deterministic Google event id (idempotent create/delete).
  eventId     String
  /// JSON event body for creates (summary, start, end, …).
  payload     String?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([doneAt])
}

// ── Dragons ──────────────────────────────────────────────────────────────────

/// Owner customisations for an area dragon (growth itself is derived from XP).
model DragonProfile {
  /// Area id, e.g. "fitness".
  areaId     String   @id
  customName String?
  /// Equipped cosmetic item id from the treasure shop (see src/features/treasury/catalog.ts).
  accessory  String?
  /// Evolution path chosen from stage 10: "armoured" | "swift" (null = undecided).
  path       String?
  updatedAt  DateTime @updatedAt
}

/// Gold spent in the treasure shop. Append-only; the gold balance is derived
/// (earned from deeds/bonuses minus purchases). One purchase per item.
model Purchase {
  id          String   @id @default(cuid())
  itemId      String   @unique
  price       Int
  purchasedAt DateTime @default(now())
}

// ── Honour: customisable good / bad actions ─────────────────────────────────

/// A user-defined good or bad action, e.g. "Gym session" (+20, good) or
/// "Takeaway" (15, bad). Definitions persist day to day; archiving hides an
/// action from logging without losing its history.
model PointAction {
  id              String       @id @default(cuid())
  name            String
  /// "good" | "bad" (validated in src/features/honour/schemas.ts)
  kind            String
  /// Positive magnitude. Good adds Honour (and XP); bad subtracts Honour.
  points          Int
  icon            String
  category        String
  sortOrder       Int          @default(0)
  /// Optional goal: times per week (Mon–Sun, Europe/London). Good actions only.
  weeklyTarget    Int?
  /// If-then plan cue, e.g. "After my morning coffee" (implementation intention).
  cue             String?
  /// Optional reminder time for the plan, "HH:MM" Europe/London.
  cueTime         String?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  version         Int          @default(1)
  updatedByDevice String       @default("pc")
  entries         PointEntry[]

  @@index([kind, archivedAt])
}

/// Append-only Honour/XP ledger. Never updated or deleted: an undo is a new
/// entry that reverses the original (`reversesEntryId`). Totals are derived.
model PointEntry {
  id              String      @id @default(cuid())
  actionId        String
  action          PointAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  /// Snapshots so history stays correct if the action is later edited.
  kind            String
  actionName      String
  actionIcon      String
  /// Category at the time of logging — decides which area dragon gets the XP.
  actionCategory  String      @default("Other")
  /// Optional short note from the owner ("5k in 28 min"). Not part of scoring.
  note            String?
  /// Signed change to the Honour score.
  honourDelta     Int
  /// Change to XP (good actions only; negative only when reversing a good entry).
  xpDelta         Int
  /// Local calendar day (Europe/London), YYYY-MM-DD.
  occurredOn      String
  occurredAt      DateTime    @default(now())
  /// Client-generated key: a retried request never creates a second entry.
  idempotencyKey  String      @unique
  /// Set on reversal entries; unique so an entry can only be undone once.
  reversesEntryId String?     @unique
  createdAt       DateTime    @default(now())
  updatedByDevice String      @default("pc")

  @@index([occurredOn])
  @@index([actionId])
  @@index([actionCategory])
}

// ── Money (all amounts in integer pence, GBP) ───────────────────────────────

/// A spending category with an optional monthly limit.
model BudgetCategory {
  id                String        @id @default(cuid())
  name              String        @unique
  icon              String
  /// Monthly budget in pence; 0 = track only, no limit.
  monthlyLimitPence Int           @default(0)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  version           Int           @default(1)
  transactions      Transaction[]
}

/// One money movement. amountPence > 0 = spending, < 0 = income/refund.
/// Soft-deleted (deletedAt) so history and audit stay intact.
model Transaction {
  id          String          @id @default(cuid())
  occurredOn  String
  amountPence Int
  description String
  categoryId  String?
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// "manual" | "import"
  source      String          @default("manual")
  /// Import de-duplication fingerprint (null for manual entries).
  importHash  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([occurredOn])
  @@index([categoryId])
}

model SavingsGoal {
  id          String           @id @default(cuid())
  name        String
  icon        String
  targetPence Int
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  deposits    SavingsDeposit[]
}

/// Append-only: withdrawals are negative deposits.
model SavingsDeposit {
  id          String      @id @default(cuid())
  goalId      String
  goal        SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  amountPence Int
  occurredOn  String
  createdAt   DateTime    @default(now())

  @@index([goalId])
}

// ── Body (health data: stays on this PC, never logged) ──────────────────────

/// One exercise entry in a workout. Weight in grams (int) to avoid floats.
model WorkoutSet {
  id          String    @id @default(cuid())
  occurredOn  String
  exercise    String
  sets        Int
  reps        Int
  weightGrams Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([occurredOn])
  @@index([exercise])
}

/// One run. Distance in metres, time in seconds.
model RunLog {
  id              String    @id @default(cuid())
  occurredOn      String
  distanceMetres  Int
  durationSeconds Int
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@index([occurredOn])
}

/// Glasses of water drunk on a day (one row per day).
model WaterDay {
  day       String   @id
  glasses   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A night's sleep, keyed by the day you woke up. Times are "HH:MM" local.
model SleepLog {
  day       String   @id
  bedTime   String
  wakeTime  String
  minutes   Int
  updatedAt DateTime @updatedAt
}

/// Body weight for a day, in grams.
model WeightLog {
  day       String   @id
  grams     Int
  updatedAt DateTime @updatedAt
}

// ── Mind (reading, study, reflection: private, never logged) ────────────────

model Book {
  id         String       @id @default(cuid())
  title      String
  author     String       @default("")
  totalPages Int
  /// Set when pages read reaches totalPages.
  finishedOn String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  logs       ReadingLog[]
}

/// Pages read in one sitting. Append-only; a book's progress is the sum.
model ReadingLog {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  day       String
  pages     Int
  createdAt DateTime @default(now())

  @@index([bookId])
  @@index([day])
}

/// Spaced-repetition card (Leitner boxes 1-5).
model Flashcard {
  id         String       @id @default(cuid())
  deck       String       @default("Security+")
  topic      String       @default("")
  front      String
  back       String
  box        Int          @default(1)
  dueOn      String
  /// FSRS memory state (null until first FSRS review). Days / 1–10.
  stability  Float?
  difficulty Float?
  lastReviewOn String?
  /// Stable key for starter cards so re-seeding never duplicates.
  seedKey    String?      @unique
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  reviews    CardReview[]

  @@index([dueOn])
}

model CardReview {
  id        String    @id @default(cuid())
  cardId    String
  card      Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  day       String
  correct   Boolean
  /// FSRS grade: 1 Again, 2 Hard, 3 Good, 4 Easy (null for older Leitner reviews).
  grade     Int?
  createdAt DateTime  @default(now())

  @@index([day])
}

/// One per day: mood 1-5 and/or a short journal entry.
model Reflection {
  day       String   @id
  mood      Int?
  entry     String?
  updatedAt DateTime @updatedAt
}

/// A completed focus (Pomodoro) session.
model FocusSession {
  id        String   @id @default(cuid())
  day       String
  minutes   Int
  label     String   @default("")
  createdAt DateTime @default(now())

  @@index([day])
}

// ── Push notifications (iPhone / PC home-screen app) ────────────────────────

/// A browser push subscription. Endpoint is the push service URL (Apple/Google/Mozilla).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  failures  Int      @default(0)
}

/// One row per notification sent, so each reminder fires at most once per day.
model PushLog {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Sunday weekly review: three short reflections per week (keyed by the Monday).
model WeeklyReview {
  weekStart String   @id
  win       String   @default("")
  obstacle  String   @default("")
  change    String   @default("")
  updatedAt DateTime @updatedAt
}

/// A finished Security+ mock exam (self-marked). Per-topic results as JSON.
model MockExam {
  id          String   @id @default(cuid())
  takenOn     String
  durationSec Int
  total       Int
  correct     Int
  /// [{ "topic": string, "total": number, "correct": number }]
  byTopic     String
  createdAt   DateTime @default(now())
}
